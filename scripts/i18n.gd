var lang := "ms"


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	var tr_en := Translation.new()
	tr_en.locale = "en"
	for k in EN:
		tr_en.add_message(k, EN[k])
	tr_en.add_message(HOW_TO_MS, HOW_TO_EN)
	var dir := DirAccess.open("res://translations")
	if dir != null:
		for f in dir.get_files():
			if f.ends_with(".json"):
				var extra: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://translations/" + f))
				if extra is Dictionary:
					for k in extra:
						tr_en.add_message(k, extra[k])
	TranslationServer.add_translation(tr_en)
	var cfg := ConfigFile.new()
	if cfg.load(CFG) == OK:
		lang = cfg.get_value("game", "lang", "ms")
	set_lang(lang, false)


func set_lang(l: String, save := true) -> void:
	lang = l
	TranslationServer.set_locale(l)
	if save:
		var cfg := ConfigFile.new()
		cfg.load(CFG)
		cfg.set_value("game", "lang", l)
		cfg.save(CFG)


func t(s: String) -> String:
	if lang == "ms":
		return s
	return TranslationServer.translate(s)


